<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NOT: SolidWorks eklentileri .NET Framework gerektirir (SolidWorks'ün
    kendisi COM tabanlıdır, .NET Framework'ün COM Interop desteğine dayanır).
    .NET 8 SDK ile de bu "SDK-style" proje formatı derlenebilir, TargetFramework
    aşağıdaki gibi net48 kalmalı.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>UretimOSKesim</AssemblyName>
    <RootNamespace>UretimOSKesim</RootNamespace>
    <!-- COM kaydı BİLEREK OTOMATİK DEĞİL: Visual Studio'yu yönetici modunda
         tutarlı şekilde açmak bazı Windows/kurumsal ayarlarında güvenilir
         çalışmıyor. Kayıt, derlemeden SONRA elle (yönetici Komut İstemi'nden
         regasm.exe /codebase ile) yapılıyor — bkz. README.md "Kurulum"
         bölümü. Böylece normal (yönetici olmayan) Visual Studio'da sorunsuz
         derlenir, kayıt adımı tek seferlik ve bağımsız kalır. -->
    <RegisterForComInterop>false</RegisterForComInterop>
    <EnableComHosting>false</EnableComHosting>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- KRİTİK: "Any CPU" ile derlenirse regasm'ın 32-bit sürümü çalışır ve
         kayıt HKLM\SOFTWARE\WOW6432Node altına yazılır — 64-bit SolidWorks
         orayı HİÇ okumaz, eklenti "Add-Ins" listesinde görünmez. x64'e
         sabitleyerek 64-bit regasm'ın gerçek (WOW6432Node'suz) HKLM\SOFTWARE
         altına yazmasını garantiliyoruz. -->
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <!-- <ComVisible>true</ComVisible> MSBuild özelliği gerçek denemede
         regasm'a yansımadı (hâlâ "Kaydedilen tür yok" çıktı) — bunun yerine
         src/AssemblyInfo.cs'te [assembly: ComVisible(true)] ELLE yazıldı.
         Bu da SDK'nın kendi otomatik ürettiği (ve varsayılan ComVisible
         değeri belirsiz olan) ayar dosyasıyla ÇAKIŞMASIN diye SDK'nın
         otomatik üretimi burada kapatıldı. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <!--
    SolidWorks Interop referansları — YOLLARI KENDİ KURULUMUNUZA GÖRE
    DÜZELTİN. Genellikle şurada bulunurlar:
      C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS\api\redist\
    (SolidWorks SDK kurulu değilse: SolidWorks kurulum diskinde
    "sdk\redist" veya "api\redist" klasörü.)
    EmbedInteropTypes=false ÖNEMLİ: SolidWorks interop tipleri COM üzerinden
    canlı nesnelerle çalışır, gömülü (embedded) tip kullanılırsa çökme olur.
  -->
  <ItemGroup>
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS\api\redist\SolidWorks.Interop.sldworks.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS\api\redist\SolidWorks.Interop.swconst.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <Reference Include="SolidWorks.Interop.swpublished">
      <HintPath>C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS\api\redist\SolidWorks.Interop.swpublished.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <Reference Include="SolidWorksTools">
      <!-- NOT: bu dosya bazı kurulumlarda api\redist yerine SOLIDWORKS ana
           klasöründe duruyor (küçük harfle "solidworkstools.dll") — yol
           bulunamazsa Windows'ta arama yapıp gerçek konumu buraya yazın. -->
      <HintPath>C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS\solidworkstools.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <!-- SolidWorksTools.dll, [SwAddin] özniteliğini (AddinAttribute) taşır —
         SwAddin.cs'in başındaki [SwAddin(...)] bu paketten gelir. -->
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

</Project>
