<Project Sdk="Microsoft.NET.Sdk">

  <!--
    NOT: SolidWorks eklentileri .NET Framework gerektirir (SolidWorks'ün
    kendisi COM tabanlıdır, .NET Framework'ün COM Interop desteğine dayanır).
    .NET 8 SDK ile de bu "SDK-style" proje formatı derlenebilir, TargetFramework
    aşağıdaki gibi net48 kalmalı.
  -->
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>UretimOSKesim</AssemblyName>
    <RootNamespace>UretimOSKesim</RootNamespace>
    <!-- COM kaydı BİLEREK OTOMATİK DEĞİL: Visual Studio'yu yönetici modunda
         tutarlı şekilde açmak bazı Windows/kurumsal ayarlarında güvenilir
         çalışmıyor. Kayıt, derlemeden SONRA elle (yönetici Komut İstemi'nden
         regasm.exe /codebase ile) yapılıyor — bkz. README.md "Kurulum"
         bölümü. Böylece normal (yönetici olmayan) Visual Studio'da sorunsuz
         derlenir, kayıt adımı tek seferlik ve bağımsız kalır. -->
    <RegisterForComInterop>false</RegisterForComInterop>
    <EnableComHosting>false</EnableComHosting>
    <LangVersion>latest</LangVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- KRİTİK: "Any CPU" ile derlenirse regasm'ın 32-bit sürümü çalışır ve
         kayıt HKLM\SOFTWARE\WOW6432Node altına yazılır — 64-bit SolidWorks
         orayı HİÇ okumaz, eklenti "Add-Ins" listesinde görünmez. x64'e
         sabitleyerek 64-bit regasm'ın gerçek (WOW6432Node'suz) HKLM\SOFTWARE
         altına yazmasını garantiliyoruz. -->
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <!-- <ComVisible>true</ComVisible> MSBuild özelliği gerçek denemede
         regasm'a yansımadı (hâlâ "Kaydedilen tür yok" çıktı) — bunun yerine
         src/AssemblyInfo.cs'te [assembly: ComVisible(true)] ELLE yazıldı.
         Bu da SDK'nın kendi otomatik ürettiği (ve varsayılan ComVisible
         değeri belirsiz olan) ayar dosyasıyla ÇAKIŞMASIN diye SDK'nın
         otomatik üretimi burada kapatıldı. -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- Çok sayfalı rapor (Excel/PDF) için — kullanıcı isteği: her parça
         için ayrı sayfa/sekme + gömülü teknik resim JPG'i, tek CSV'nin
         yerine. İkisi de Excel/Adobe kurulu OLMADAN, saf .NET ile dosya
         üretir (COM otomasyonu DEĞİL — SolidWorks'ün kendi COM'uyla
         zaten yeterince riskli deneyim yaşadık, ayrıca bir Excel/PDF COM
         otomasyonu eklemek istemedik). -->
    <PackageReference Include="ClosedXML" Version="0.102.3" />
    <PackageReference Include="PdfSharp" Version="1.50.5147" />
  </ItemGroup>

  <!--
    SolidWorks Interop referansları — YOLLARI KENDİ KURULUMUNUZA GÖRE
    DÜZELTİN. Genellikle şurada bulunurlar:
      C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS\api\redist\
    (SolidWorks SDK kurulu değilse: SolidWorks kurulum diskinde
    "sdk\redist" veya "api\redist" klasörü.)
    EmbedInteropTypes=false ÖNEMLİ: SolidWorks interop tipleri COM üzerinden
    canlı nesnelerle çalışır, gömülü (embedded) tip kullanılırsa çökme olur.
  -->
  <!-- KESİN TANI #6 (gerçek çökme kanıtı): SWERR günlüğündeki <EXEDIR>
       "C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS (2)" idi — makinede İKİ
       ayrı SolidWorks kurulumu var ("SOLIDWORKS" eski/2023, "SOLIDWORKS (2)"
       gerçekten çalışan 2025 SP3.0). Referanslar önceden ESKİ "SOLIDWORKS"
       (2) OLMAYAN) klasöründen alınıyordu — yani kod, ÇALIŞAN SolidWorks'ten
       FARKLI bir sürümün arayüz tanımına göre derleniyordu. Bu tür sürüm
       uyuşmazlığı, temel çağrıların (CreateCommandGroup2, AddCommandItem2,
       özellik atamaları) sessizce "çalışıp" ama Activate() gibi dahili COM
       vtable düzenine daha duyarlı çağrıların rastgele bellek adresine
       düşüp native çökmesine yol açar — kod içeriğini (ikon, bayrak, GUID,
       ID) ne kadar değiştirirsek değiştirelim çökmenin HİÇ etkilenmemesinin
       gerçek sebebi buydu. Kullanıcının kendi makinesinde doğrulanan doğru
       yol: C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS (2)\api\redist\ -->
  <ItemGroup>
    <Reference Include="SolidWorks.Interop.sldworks">
      <HintPath>C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS (2)\api\redist\SolidWorks.Interop.sldworks.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <Reference Include="SolidWorks.Interop.swconst">
      <HintPath>C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS (2)\api\redist\SolidWorks.Interop.swconst.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <Reference Include="SolidWorks.Interop.swpublished">
      <HintPath>C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS (2)\api\redist\SolidWorks.Interop.swpublished.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <Reference Include="SolidWorksTools">
      <!-- NOT: bu dosya bazı kurulumlarda api\redist yerine SOLIDWORKS ana
           klasöründe duruyor (küçük harfle "solidworkstools.dll") — yol
           bulunamazsa Windows'ta arama yapıp gerçek konumu buraya yazın
           (bu makinede "SOLIDWORKS (2)" kök klasörüne bakın). -->
      <HintPath>C:\Program Files\SOLIDWORKS Corp\SOLIDWORKS (2)\solidworkstools.dll</HintPath>
      <EmbedInteropTypes>false</EmbedInteropTypes>
    </Reference>
    <!-- SolidWorksTools.dll, [SwAddin] özniteliğini (AddinAttribute) taşır —
         SwAddin.cs'in başındaki [SwAddin(...)] bu paketten gelir. -->
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <!-- İkon şeridi PROGRAMLA üretmek için (KomutlariKur/IkonlariHazirla) —
         ICommandGroup.IconList boş bırakılamıyor, gerçek denemede bu tam
         olarak "Access Violation ... virtual address 0" çökmesine sebep
         oldu (bkz. SwAddin.cs "KESİN TANI #2" notu). UseWindowsForms=true
         genelde System.Drawing'i de getirir ama emin olmak için elle
         referans veriyoruz. -->
    <Reference Include="System.Drawing" />
    <!-- .NET Framework 4.8'de System.Net.Http (UretimOSApiClient.cs'in
         HttpClient kullanımı için) VARSAYILAN olarak eklenmez, elle
         referans vermek gerekir — gerçek denemede CS0234/CS0246 hatası
         verdi. -->
    <Reference Include="System.Net.Http" />
    <!-- ZipArchive/ZipArchiveMode (KesimListesiCikarici.cs'in ZIP paketleme
         kısmı) için — gerçek denemede CS0012/CS0103 hatası verdi. -->
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <!-- 'dynamic' anahtar kelimesi (UretimOSApiClient.cs'te JSON çözümlemede
         kullanıldı) derleyicinin runtime binder'ı için bu referansı ister —
         gerçek denemede CS0656 hatası verdi. -->
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

</Project>
